# Example environment variables for the arcane-agent compose stack.
# Copy this file to .env in the same directory and fill in your real token:
#   cp .env.example .env
#
# Docker Compose automatically reads .env from this directory when
# interpolating variables in compose.yaml.

# Agent token minted by your main Arcane instance.
# Get it from the Arcane web UI: Environments -> Add Environment ->
# "Generate Agent Configuration" (starts with arc_...).
# The token is only shown once — copy it immediately.
AGENT_TOKEN=arc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL of the MAIN Arcane server, reachable from this agent.
# This differs per deployment:
#   - Agent on the same machine as the main Arcane server:
#       MANAGER_API_URL=http://localhost:3552
#   - Remote agent over Tailscale, direct to the server:
#       MANAGER_API_URL=http://<main-arcane-tailscale-ip>:3552
#   - Remote agent via reverse proxy (e.g. nginx/caddy on the server):
#       MANAGER_API_URL=https://arcane.example.com
#
# If the agent can't reach the manager, check Tailscale ACLs allow
# this node -> the main server, and that the port is actually bound
# on the server's Tailscale interface (not just 127.0.0.1).
MANAGER_API_URL=http://localhost:3552
